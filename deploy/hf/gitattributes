# Large build inputs must go through LFS — the Hub rejects plain files >10 MB.
data/*.csv                filter=lfs diff=lfs merge=lfs -text
seeds/neo4j/**/*.dump     filter=lfs diff=lfs merge=lfs -text
seeds/chroma/**           filter=lfs diff=lfs merge=lfs -text

# The Hub rejects any binary blob outside LFS/Xet regardless of size — the eval
# charts rendered into validation/corpus/eval/ are the ones this catches.
*.png                     filter=lfs diff=lfs merge=lfs -text
*.jpg                     filter=lfs diff=lfs merge=lfs -text
*.jpeg                    filter=lfs diff=lfs merge=lfs -text
*.pdf                     filter=lfs diff=lfs merge=lfs -text
