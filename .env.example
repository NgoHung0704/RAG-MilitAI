# Neo4j connection (the `real` dataset instance)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Synthetic-dataset Neo4j instances (separate instances, distinct bolt ports).
# Defaults shown; override only if you remap the host ports.
NEO4J_URI_SYNTH_COMPLETE=bolt://localhost:7688
NEO4J_URI_SYNTH_MASKED=bolt://localhost:7689

# DeepSeek API (for NL2Cypher and RAG generation)
DEEPSEEK_API_KEY=sk-...

# RAG / ChromaDB config
CHROMA_PERSIST_DIR=data/chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5

# Data paths
DATA_PATH=data/full_unified_annotations_patch.csv
SAMPLE_DATA_PATH=data/sample_of_data.csv

# First-run auto-ingestion scope: all (default) | synth | off
MILITAI_AUTOINGEST=all

# RAG evaluation judge (validation/evaluate.py --rag). The judge runs via
# OpenRouter and must be a different model family than the DeepSeek generator.
OPENROUTER_API_KEY=sk-or-...
JUDGE_MODEL=google/gemma-4-31b-it
